# Copy to .env.local for local development. In production set these in
# Cloudflare Pages > Settings > Environment variables (see OFF_SITE_CHECKLIST.md).
# Never commit real keys: this repository is public.

# --- Public, used at build time (safe to expose in the browser) ---
# Cal.com booking link, e.g. https://cal.com/ezomod/30min
NEXT_PUBLIC_CAL_LINK={{TODO: Cal.com booking URL}}
# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (nothing loads if empty)
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Secret, used only by the Pages Function functions/api/contact.ts ---
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Ezomod Website <website@ezomod.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered
CONTACT_TO_EMAIL=Ezomodalltech@ezomod.com
TURNSTILE_SECRET_KEY=
